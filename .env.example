# Use a separate Neon database for each environment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required when running the seed command. Allowed values: local, test
APP_ENV=local

# Authentication (Better Auth). Generate a strong secret, e.g. `openssl rand -base64 32`.
# Required in production; local/test fall back to development placeholders.
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client for identity sign-in. Use a separate client per environment.
# Calendar authorization is requested separately (see the Calendar feature).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
