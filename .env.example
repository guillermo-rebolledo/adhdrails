# Use a separate Neon database for each environment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Tier marker. Locally use `local` (or `test` for the test runtime). Deployed
# environments set this in Vercel: `staging` on the staging custom environment,
# `production` on Production. The release scripts refuse to mutate an environment
# whose APP_ENV does not match the release target, and seeding is limited to
# local/test — production seeding is disabled by construction.
APP_ENV=local

# Authentication (Better Auth). Generate a strong secret, e.g. `openssl rand -base64 32`.
# Required in production; local/test fall back to development placeholders.
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client for identity sign-in. Use a separate client per environment.
# The same client is reused for the separate, incremental Calendar authorization.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Calendar refresh-token encryption. Keys are versioned so they can rotate:
# CALENDAR_TOKEN_KEY_V<n> is a base64-encoded 32-byte AES-256 key and
# CALENDAR_TOKEN_KEY_VERSION selects the version new tokens are sealed under.
# Required in production (a production `next start` build enforces it); local
# `next dev` and the test runtime fall back to a deterministic development key.
# Generate one with: openssl rand -base64 32
CALENDAR_TOKEN_KEY_VERSION=1
CALENDAR_TOKEN_KEY_V1=replace-with-a-base64-encoded-32-byte-key

# Browser notifications. Generate a VAPID key pair once per environment with
# `pnpm exec web-push generate-vapid-keys --json`. Keep the private key server-only.
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=replace-with-a-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-a-vapid-private-key

# Content-free product analytics (Umami Cloud, US region). Leave the website id
# unset to disable analytics entirely — local and preview builds should not
# report into the production property. The tracker script is pinned to the US
# host in code and is not configurable.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Operational audit pseudonym secret. Stable per environment; derives the opaque
# account reference on metadata-only audit records so a raw account id is never
# stored. Generate with: openssl rand -base64 32. Local/test fall back to a
# deterministic development value.
OPERATIONAL_AUDIT_PSEUDONYM_SECRET=replace-with-a-strong-random-secret

# Neon restore points, PITR retention verification, and the restore drill. Only
# needed for production releases (`pnpm release:production`, `pnpm restore:drill`,
# `pnpm release:rehearsal`). Scope these to the production Neon project; never set
# them on Preview. NEON_BRANCH_ID is the production branch the snapshot and
# restore drill act on.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
