{
  "name": "rails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "tsx scripts/test-with-postgres.ts",
    "test:watch": "vitest",
    "analyze": "next experimental-analyze --output",
    "lighthouse": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worktree:create": "bash scripts/create-worktree.sh",
    "release:check": "pnpm verify",
    "release:staging": "pnpm release:check && tsx scripts/release-staging.ts",
    "release:production": "pnpm release:check && tsx scripts/release-production.ts",
    "release:rehearsal": "tsx scripts/production-readiness.ts",
    "restore:drill": "tsx scripts/restore-drill.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm lighthouse"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@next/env": "16.2.12",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/otel": "^2.1.3",
    "better-auth": "^1.6.25",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "inngest": "^4.13.0",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "serwist": "^9.5.12",
    "shadcn": "^4.15.0",
    "tailwind-merge": "3.3.1",
    "temporal-polyfill": "0.3.0",
    "tw-animate-css": "1.4.0",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.0.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.9",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vercel": "57.0.0",
    "vitest": "4.1.10"
  }
}
